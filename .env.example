TELEGRAM_TOKEN=your-telegram-bot-token-here
OPENAI_API_KEY=your-openai-api-key-here
# Set to your public HTTPS URL including /webhook path to use webhook mode.
# Leave unset to use polling mode (default for local development).
# WEBHOOK_URL=https://your-app.fly.dev/webhook
# Number of suggested replies shown when clicking "Reply" (default: 4)
# N_SUGGESTED_REPLIES=4

# LangSmith tracing + feedback (optional — omit to disable both; the bot still runs).
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your-langsmith-api-key-here
# LANGSMITH_PROJECT=tg-language-assistant
# Hash Telegram user IDs before they leave the system to LangSmith (default: true).
# HASH_TELEGRAM_USER_ID=true
