TELEGRAM_TOKEN=your-telegram-bot-token-here
OPENAI_API_KEY=your-openai-api-key-here
# Optional: route the Chinese target language to a Qwen model via Alibaba Cloud's
# DashScope OpenAI-compatible endpoint. Leave unset to use MODEL_NAME for Chinese too.
# QWEN_API_KEY=your-dashscope-api-key-here
# QWEN_MODEL_NAME=qwen-plus
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Set to your public HTTPS URL including /webhook path to use webhook mode.
# Leave unset to use polling mode (default for local development).
# WEBHOOK_URL=https://your-app.fly.dev/webhook
# Number of suggested replies shown when clicking "Reply" (default: 4)
# N_SUGGESTED_REPLIES=4
